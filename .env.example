# Optional OpenAI-compatible chat-completions endpoint (exact full URL).
# Hosted runtime secrets are configured through Sites, never in client code.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# AES-256-GCM key: 64 hexadecimal characters. Required for canonical profiles.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Preserve the same key across restarts; changing it requires a planned data migration.
PROFILE_ENCRYPTION_KEY=

# Local PostgreSQL mode. Start the API in one terminal, Vite with the proxy in another.
DATABASE_URL=postgresql://disputepilot:local-demo-only@127.0.0.1:5432/disputepilot
B2C_POSTGRES_API=http://127.0.0.1:8788
